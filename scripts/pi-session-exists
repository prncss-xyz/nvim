#!/usr/bin/env python3
"""Print whether a named Pi session exists for a working directory."""

import argparse
import json
import os
from pathlib import Path
import sys


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("title", help="Exact Pi session name")
    parser.add_argument("path", help="Session working directory")
    args = parser.parse_args()

    cwd = os.path.abspath(os.path.expanduser(args.path))
    directory = Path.home() / ".pi" / "agent" / "sessions"
    encoded = cwd.lstrip(os.sep).replace("/", "-").replace("\\", "-").replace(":", "-")
    sessions = directory / f"--{encoded}--"

    try:
        for file in sessions.glob("*.jsonl"):
            with file.open(encoding="utf-8") as stream:
                header = json.loads(next(stream))
                if header.get("type") != "session" or header.get("cwd") != cwd:
                    continue
                name = None
                for line in stream:
                    entry = json.loads(line)
                    if entry.get("type") == "session_info":
                        name = entry.get("name")
                if name == args.title:
                    print("yes")
                    return 0
    except (OSError, ValueError, StopIteration) as error:
        print(f"Could not read Pi sessions: {error}", file=sys.stderr)
        return 1

    print("no")
    return 0


if __name__ == "__main__":
    sys.exit(main())
